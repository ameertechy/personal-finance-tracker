# =============================================================================
# DirhamPulse UAE — Personal Finance Tracker Environment Configuration
# Copy this file to `.env.local` and supply your own credentials.
# NEVER commit real API keys, service role keys, or secrets to version control.
# =============================================================================

# PostgreSQL (required)
# docker compose builds DATABASE_URL itself from POSTGRES_PASSWORD; set these three for Docker.
# Generate each with:  openssl rand -hex 32   (hex avoids characters that break the DB URL)
POSTGRES_PASSWORD="change-me-hex-only"
SESSION_SECRET="change-me-random-32-byte-hex"
RECEIPT_SIGNING_SECRET="change-me-random-32-byte-hex"
# Only when running the app outside Docker against your own PostgreSQL:
# DATABASE_URL="postgresql://user:password@localhost:5432/dirhampulse"
# (`npm run dev:local` needs none of this: it starts a local PGlite database itself.)

# Public Supabase Configuration (Safe for Browser Client with RLS enabled)
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-public-key-placeholder"

# Server-Only Supabase Service Role & Private Receipt Signing Keys
# NEVER prefix these with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-secret-placeholder"

# Optional Server-Only Vision / OCR Provider Credentials
# When omitted, the built-in deterministic UAE Receipt & Bank SMS/Screenshot parser is used.
OPENAI_API_KEY="sk-your-openai-api-key-placeholder"
OCR_PROVIDER_MODEL="gpt-4o-mini"

# Default Regional Configuration
NEXT_PUBLIC_DEFAULT_CURRENCY="AED"
NEXT_PUBLIC_DEFAULT_TIMEZONE="Asia/Dubai"
